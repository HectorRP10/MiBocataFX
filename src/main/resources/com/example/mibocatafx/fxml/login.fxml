<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="20.0" stylesheets="@../css/estilos.css" styleClass="vbox-padding"
      xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.mibocatafx.controller.LoginController" style="-fx-background-color: #FFF4D9">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <ImageView fx:id="image_login" >
        <image>
            <Image url="@../images/logoMiBocata.png" />
        </image>
    </ImageView>

    <Label text="Usuario:" />

    <TextField fx:id="usernameField"/>

    <Label text="Contraseña:" />

    <PasswordField fx:id="passwordField" />

    <Button fx:id="btnLogin" text="Entrar" onAction="#onLoginButtonClick" styleClass="button"/>
    <Hyperlink text="Recuperar contraseña" />
</VBox>
