<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mibocatafx.controller.DashboardAlumnoController">
    <top>
        <ToolBar prefHeight="125.0" prefWidth="200.0" BorderPane.alignment="CENTER" style="-fx-background-color: #FFF4D9;">
            <items>
                <ImageView fitHeight="150.0" fitWidth="180.0"  pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logoMiBocata.png" />
                    </image>
                </ImageView>
                <Button fx:id="btnHistorial" prefHeight="30.0" prefWidth="73.0" text="Historial" style="-fx-background-color: #FFF4D9; -fx-border-color: #000000; -fx-border-width: 1px;-fx-font-weight: bold;" />
                <Button fx:id="btnCerrarSesion" prefHeight="30.0" prefWidth="73.0" text="Cerrar sesión" style="-fx-background-color: #FFF4D9; -fx-border-color: #000000; -fx-font-weight: bold; -fx-border-width: 1px;"/>
            </items>
        </ToolBar>
    </top>

    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER" alignment="TOP_CENTER">
            <Label text="SELECCIONE BOCADILLO" style="-fx-font-size: 20px; -fx-font-weight: bold; " />

            <VBox fx:id="bocadilloContainer" spacing="5.0" />

        </VBox>
    </center>
</BorderPane>
