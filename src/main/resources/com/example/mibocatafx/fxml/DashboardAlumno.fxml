<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mibocatafx.controller.DashboardAlumnoController">
    <top>
        <ToolBar prefHeight="125.0" prefWidth="200.0" BorderPane.alignment="CENTER" style="-fx-background-color: #FFF4D9;">
            <items>
                <!-- Imagen a la izquierda -->
                <ImageView fitHeight="150.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logoMiBocata.png" />
                    </image>
                </ImageView>

                <!-- Espaciador para alinear los botones a la derecha -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Contenedor de botones con alineación a la derecha -->
                <HBox alignment="CENTER_RIGHT" spacing="20" style="-fx-padding: 0 20 0 0;">
                    <Button fx:id="btnHistorial" prefHeight="30.0" prefWidth="73.0" text="Historial" style="-fx-background-color: #FFF4D9; -fx-border-color: #000000; -fx-border-width: 1px;-fx-font-weight: bold;" />
                    <Button fx:id="btnCerrarSesion" prefHeight="30.0" prefWidth="100.0" text="Cerrar sesión" style="-fx-background-color: #FFF4D9; -fx-border-color: #000000; -fx-font-weight: bold; -fx-border-width: 1px;"/>
                </HBox>
            </items>
        </ToolBar>
    </top>


    <center>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER" alignment="TOP_CENTER" spacing="20.0">
            <Region prefHeight="10.0" />
            <Label text="SELECCIONE BOCADILLO" style="-fx-font-size: 25px; -fx-font-weight: bold;" />

            <!-- Region vacío para crear espacio antes del HBox -->
            <Region prefHeight="90.0" />

            <HBox fx:id="bocadilloContainer" spacing="10.0" BorderPane.alignment="CENTER" alignment="TOP_CENTER"/>
        </VBox>

    </center>

</BorderPane>
