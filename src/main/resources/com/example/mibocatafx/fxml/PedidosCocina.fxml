<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="borderPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mibocatafx.controller.PedidosCocinaController">

    <top>
        <ToolBar styleClass="toolbar" BorderPane.alignment="CENTER">
            <items>
                <ImageView fx:id="image_toolbar" fitHeight="150.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logoMiBocata.png" />
                    </image>
                </ImageView>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="hbox-right">
                    <Button fx:id="btnCerrarSesion" onAction="#btnCerrarSesion" styleClass="button" text="Cerrar sesión" />
                </HBox>
            </items>
        </ToolBar>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
                <ComboBox fx:id="tipoBocadillo" prefHeight="26.0" prefWidth="150.0" promptText="Tipo de bocadillo" />
                <Button fx:id="filtrar" mnemonicParsing="false" onAction="#findBuscador" text="Filtrar" />
            </HBox>

            <TableView fx:id="tabla" prefHeight="228.0" prefWidth="600.0" style="-fx-cell-size: 30px;">
                <columns>
                    <TableColumn fx:id="tabla_id" prefWidth="75.0" text="Id" />
                    <TableColumn fx:id="tabla_nombreAlumno" prefWidth="75.0" text="Alumno" />
                    <TableColumn fx:id="tabla_bocadillo" prefWidth="75.0" text="Bocadillo" />
                    <TableColumn fx:id="precio" prefWidth="75.0" text="Precio" />
                    <TableColumn fx:id="tabla_descuento" prefWidth="75.0" text="Descuento" />
                    <TableColumn fx:id="fecha" prefWidth="75.0" text="Fecha" />
                    <TableColumn fx:id="retirado" prefWidth="75.0" text="Retirado" />
                    <TableColumn fx:id="tabla_retirar" prefWidth="75.0" text="Retirar" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>


            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#anteriorPagina" text="&lt;" />
                <TextField fx:id="txtPagina" prefHeight="26.0" prefWidth="96.0" />
                <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#siguientePagina" text="&gt;" />
            </HBox>

            <Label fx:id="lblTotalPaginas" />
        </VBox>
    </center>

    <right>
        <VBox alignment="TOP_RIGHT" spacing="10" style="-fx-padding: 5 50 5 5;">
            <HBox fx:id="bocadilloContainerFrios" styleClass="hbox-containerTotalesFrio" />
            <HBox fx:id="bocadilloContainerCalientes" styleClass="hbox-containerTotalesCaliente" />
        </VBox>
    </right>

</BorderPane>